{
  "lgb": {
    "params_name": "l255",
    "params": {
      "objective": "regression_l1",
      "metric": "mae",
      "learning_rate": 0.05,
      "num_leaves": 255,
      "min_data_in_leaf": 400,
      "feature_fraction": 0.8,
      "bagging_fraction": 0.8,
      "bagging_freq": 1,
      "lambda_l2": 1.0,
      "max_bin": 255,
      "verbosity": -1
    }
  },
  "xgb": {
    "params_name": "d10",
    "params": {
      "objective": "reg:absoluteerror",
      "eval_metric": "mae",
      "tree_method": "hist",
      "max_bin": 256,
      "learning_rate": 0.05,
      "max_depth": 10,
      "min_child_weight": 400,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_lambda": 1.0
    }
  },
  "rule": "lowest row-weighted pooled MAE over the three dev folds, per model"
}
