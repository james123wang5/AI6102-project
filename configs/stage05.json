{
  "version": "stage05_dl_v1",
  "feature_set": "h_hist@drop",
  "models": ["gru", "tfm"],
  "seeds": [2026, 2027, 2028],
  "hidden": 128,
  "gru_layers": 3,
  "tfm_layers": 3,
  "heads": 4,
  "dropout": 0.1,
  "lr": 0.001,
  "weight_decay": 0.01,
  "warmup_epochs": 1,
  "max_epochs": 30,
  "patience": 4,
  "grad_clip": 1.0,
  "days_per_batch_gru": 4,
  "days_per_batch_tfm": 4,
  "feature_clip": 5.0,
  "recency": true,
  "blend_step": 0.05
}
